DATABASE_URL=postgresql://voley:voley@localhost:5432/voley?schema=public
PORT=4000
WEB_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
# Optional Google sub (not email) to bootstrap the first administrator.
ADMIN_GOOGLE_SUB=
NODE_ENV=development
# In-process scheduler requires a continuously running API.
PODIO_CRON_ENABLED=false
PODIO_CRON_SECRET=replace-with-a-random-secret-at-least-32-characters
# Exact verified PDF URL overrides discovery. Empty = discover from Podio.
PODIO_PDF_URL=
# Must be false until a real PDF fixture has been validated for the current layout.
PODIO_AUTO_IMPORT=false

# Reminders every 15 minutes. Alternatively invoke POST /jobs/run from an external cron.
JOBS_CRON_ENABLED=false
JOBS_CRON_SECRET=replace-with-another-random-secret-at-least-32-characters
# Check new Podio PDFs every six hours after the Monday run.
PODIO_WATCH_ENABLED=false
