{
  "name": "voley-amateur-api",
  "private": true,
  "scripts": {
    "dev": "npm run db:generate && tsc && node --watch dist/main.js",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "start": "node dist/main.js",
    "watch": "tsc --watch",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:integration": "node --test --test-concurrency=1 tests/*.integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@prisma/client": "6.19.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "prisma": "6.19.0",
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
}
